{
  "expo": {
    "name": "Pet Taxi",
    "slug": "pet-taxi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "pet-taxi",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#f59e0b"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.patimera.pettaxi"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f59e0b"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDkst1ETcYnBw4ThFA7ejICy-lcZb2D-RE"
        }
      },
      "package": "com.patimera.pettaxi",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Pet Taxi sürücünün konumunu takip etmek için konum erişimi gerektirir."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#f59e0b"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
